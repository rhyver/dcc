{
  "name": "dcc-vite",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.2.12",
  "description": "An Electron application with React and TypeScript",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "tsc": "turbo run tsc",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:unpack": "turbo run build && turbo run build:unpack --filter=@dcc/core",
    "build:win": "turbo run build && turbo run build:win --filter=@dcc/core",
    "build:mac": "turbo run build && turbo run build:mac --filter=@dcc/core",
    "build:linux": "turbo run build && turbo run build:linux --filter=@dcc/core"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@kilcekru/ts-basics": "^4.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "turbo": "^2.3.3",
    "typescript": "^5.9.2"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
