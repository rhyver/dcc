{
  "name": "@dcc/data",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "validate:deployment": "bun scripts/validate-deployment-sites.ts",
    "validate:deployment:release": "bun scripts/validate-deployment-sites.ts --require-approved",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@dcc/contracts": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@kilcekru/ts-basics": "^4.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-prettier": "^5.5.5",
    "typescript": "^6.0.3"
  }
}
