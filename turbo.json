{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "build:unpack": {
      "dependsOn": ["build"],
      "cache": false
    },
    "build:mac": {
      "dependsOn": ["build"],
      "cache": false
    },
    "build:win": {
      "dependsOn": ["build"],
      "cache": false
    },
    "build:linux": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": true
    },
    "tsc": {
      "dependsOn": ["^tsc"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "clean": {
      "dependsOn": ["^clean"]
    }
  }
}
