{
  "name": "dcc-vite",
  "version": "0.5.0-2026042501",
  "private": false,
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "description": "Digital Crew Chief - DCS Campaign Creator",
  "author": "digitalcrewchief.at",
  "homepage": "https://web.digitalcrewchief.at/",
  "scripts": {
    "format": "prettier --write .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "tsc": "turbo run tsc",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "cache:map": "cd apps/campaign && bun run cache:map",
    "build": "turbo run build",
    "build:unpack": "turbo run build && turbo run build:unpack --filter=@dcc/core",
    "build:win": "turbo run build && turbo run build:win --filter=@dcc/core",
    "build:mac": "turbo run build && turbo run build:mac --filter=@dcc/core",
    "build:linux": "turbo run build && turbo run build:linux --filter=@dcc/core",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@kilcekru/ts-basics": "^4.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "@typescript-eslint/project-service": "8.59.0",
    "@typescript-eslint/scope-manager": "8.59.0",
    "@typescript-eslint/tsconfig-utils": "8.59.0",
    "@typescript-eslint/type-utils": "8.59.0",
    "@typescript-eslint/types": "8.59.0",
    "@typescript-eslint/typescript-estree": "8.59.0",
    "@typescript-eslint/utils": "8.59.0",
    "@typescript-eslint/visitor-keys": "8.59.0",
    "typescript-eslint": "8.59.0"
  }
}
