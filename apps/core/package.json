{
  "name": "@dcc/core",
  "version": "0.5.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "cross-env CAMPAIGN_URL=http://localhost:5173 DOCUMENT_URL=http://localhost:5174 electron-vite dev",
    "build": "electron-vite build",
    "clean:dist": "node -e \"require('node:fs').rmSync('../../dist', { recursive: true, force: true })\"",
    "build:unpack": "bun run clean:dist && electron-builder --projectDir ../.. -c apps/core/electron-builder.yml --dir",
    "build:win": "bun run clean:dist && electron-builder --projectDir ../.. -c apps/core/electron-builder.yml --win",
    "build:mac": "bun run clean:dist && electron-builder --projectDir ../.. -c apps/core/electron-builder.yml --mac",
    "build:linux": "bun run clean:dist && electron-builder --projectDir ../.. -c apps/core/electron-builder.yml --linux",
    "tsc": "tsc --noEmit",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf .turbo dist out node_modules"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.50",
    "@ai-sdk/openai": "^3.0.37",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@orpc/server": "^1.10.0",
    "ai": "^6.0.105",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "neverthrow": "^8.2.0",
    "superjson": "^2.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dcc/contracts": "workspace:*",
    "@dcc/data": "workspace:*",
    "@dcc/generate-miz": "workspace:*",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.18.6",
    "cross-env": "^7.0.3",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2"
  }
}
